<%
const u_hdr   = locals.user || {};
const rol_hdr = u_hdr.id_rol || 0;
const turno   = locals.turnoActual || 'NOCHE';
const sesionCaja = locals.sesionCaja;
const avisos = locals.avisosPension || [];
const avisosVencidos = avisos.filter(a => a.dias < 0).length;
const txtVence = d => d < 0 ? 'venció hace ' + (-d) + (d === -1 ? ' día' : ' días') : (d === 0 ? 'vence hoy' : (d === 1 ? 'vence mañana' : 'vence en ' + d + ' días'));

// roles: 1 = Administrador, 2 = Cajero
const navSecciones = {
  'Operación': {
    operacion: { icon:'🅿️', label:'Entradas y salidas', roles:[1,2], url:'/operacion' },
    caja:      { icon:'💵', label:'Caja',               roles:[1,2], url:'/caja' },
    pensiones: { icon:'📇', label:'Pensiones',          roles:[1,2], url:'/pensiones', badge: avisos.length },
  },
  'Administración': {
    dashboard:     { icon:'📊', label:'Dashboard',     roles:[1], url:'/dashboard' },
    historial:     { icon:'🧾', label:'Historial',     roles:[1], url:'/historial' },
    tarifas:       { icon:'🏷️', label:'Tarifa',       roles:[1], url:'/tarifas' },
    usuarios:      { icon:'👥', label:'Usuarios',      roles:[1], url:'/usuarios' },
    configuracion: { icon:'⚙️', label:'Configuración', roles:[1], url:'/configuracion' },
  },
};
%>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title><%= locals.titulo %> | <%= APP_NAME %></title>
<link rel="icon" type="image/svg+xml" href="/assets/img/logo.svg">
<link rel="stylesheet" href="/assets/css/style.css?v=2">
<link rel="stylesheet" href="/assets/css/pos.css?v=5">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<script src="/assets/js/chart.umd.min.js" defer></script>
<script src="/assets/js/tarifa.js?v=2"></script>
<script src="/assets/js/main.js?v=2"></script>
</head>
<body>

<nav class="sidebar" id="sidebar">
  <div class="brand">
    <img src="/assets/img/logo.svg" alt="" class="brand-logo">
    <span class="brand-name"><%= APP_NAME %></span>
  </div>

  <ul class="nav-menu">
    <% Object.entries(navSecciones).forEach(([seccion, items]) => {
       if (!Object.values(items).some(item => item.roles.includes(rol_hdr))) return; %>
    <li class="nav-section"><%= seccion %></li>
    <% Object.entries(items).forEach(([key, item]) => {
       if (!item.roles.includes(rol_hdr)) return; %>
    <li class="nav-item">
      <a href="<%= item.url %>" class="<%= paginaActiva === key ? 'active' : '' %>" title="<%= item.label %>">
        <span class="nav-icon"><%= item.icon %></span>
        <span class="nav-label"><%= item.label %></span>
        <% if (item.badge > 0) { %><span class="nav-badge"><%= item.badge %></span><% } %>
      </a>
    </li>
    <% }); %>
    <% }); %>
  </ul>

  <div class="sidebar-user">
    <div class="avatar"><%= (u_hdr.nombre||'U').charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <span class="user-name"><%= u_hdr.nombre||'' %></span>
      <span class="user-role"><%= u_hdr.nombre_rol||'' %></span>
    </div>
  </div>
  <div class="sidebar-footer">
    <a href="/logout" class="btn-logout" title="Cerrar sesión">
      <span class="nav-icon">🚪</span>
      <span class="nav-label">Cerrar sesión</span>
    </a>
  </div>
</nav>

<div class="main-wrap" id="mainWrap">
  <header class="topbar">
    <button class="btn-toggle" id="btnToggle" onclick="toggleSidebar()" title="Menú">☰</button>
    <h1 class="page-title"><%= locals.titulo %></h1>
    <div class="topbar-right">
      <% if (sesionCaja) { %>
        <a href="/caja" class="badge b-verde hide-sm" style="text-decoration:none">💵 Caja #<%= sesionCaja %> abierta</a>
      <% } else { %>
        <a href="/caja" class="badge b-rojo hide-sm" style="text-decoration:none" title="No hay caja abierta">⚠️ Caja cerrada</a>
      <% } %>
      <span class="topbar-turno <%= turno==='NOCHE'?'turno-noche':'turno-manana' %>">
        <%= turno==='NOCHE' ? '🌙 Noche' : '☀️ Mañana' %>
      </span>
      <span class="topbar-date" id="reloj" data-server="<%= Date.now() %>"></span>
      <div class="dropdown" id="ddNotif">
        <button class="icon-btn" onclick="toggleDD('ddNotif')" title="Avisos de pensiones" aria-label="Avisos: <%= avisos.length %>">🔔<% if (avisos.length) { %><span class="bell-badge"><%= avisos.length > 99 ? '99+' : avisos.length %></span><% } %></button>
        <div class="dropdown-menu notif-menu">
          <div class="dd-head">Pensiones por vencer</div>
          <% if (!avisos.length) { %><div class="dd-empty">Todas las pensiones están al corriente ✨</div><% } %>
          <% avisos.slice(0, 12).forEach(a => { %>
            <a href="/pensiones" class="notif-item n-<%= a.dias < 0 ? 'danger' : 'warning' %>"><span class="ni-ico"><%= a.dias < 0 ? '⚠️' : '⏰' %></span><span><strong><%= a.placas %></strong> · <%= a.cliente %><br><small><%= txtVence(a.dias) %> (<%= helpers.fmtFecha(a.vence) %>)</small></span></a>
          <% }) %>
          <% if (avisos.length > 12) { %><a href="/pensiones" class="notif-item n-info"><span class="ni-ico">➕</span><span>y <%= avisos.length - 12 %> más…</span></a><% } %>
        </div>
      </div>
      <div class="dropdown" id="ddUser">
        <button class="user-chip" onclick="toggleDD('ddUser')">
          <span class="avatar sm"><%= (u_hdr.nombre||'U').charAt(0).toUpperCase() %></span>
          <span class="uc-text hide-sm"><strong><%= u_hdr.nombre||'' %></strong><small><%= u_hdr.nombre_rol||'' %></small></span>
          <span class="hide-sm">▾</span>
        </button>
        <div class="dropdown-menu">
          <a href="/cuenta">🔑 Cambiar mi contraseña</a>
          <a href="/logout" style="color:#c62020">🚪 Cerrar sesión</a>
        </div>
      </div>
    </div>
  </header>
  <div class="content">
  <% if (locals.msg) { %><div class="alert alert-success"><span><%- msg %></span></div><% } %>
  <% if (locals.err) { %><div class="alert alert-error"><span>❌ <%= err %></span></div><% } %>
