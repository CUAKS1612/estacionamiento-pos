# ── Variables de entorno — Estacionamiento POS ───────────────
# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3002
TZ=America/Mexico_City

# Base de datos MySQL / MariaDB (la base se crea sola si no existe)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=estacionamiento
DB_USER=root
DB_PASSWORD=
# DATABASE_URL=mysql://user:pass@host:3306/db   # alternativa (Railway, etc.)

# Clave para firmar las sesiones: usa una cadena larga y aleatoria
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Usuarios que se crean solos la primera vez (solo si la base está vacía).
# Cámbiales la contraseña desde Usuarios en cuanto entres.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=Admin123!
CAJERO_USUARIO=cajero
CAJERO_PASSWORD=Cajero123!
